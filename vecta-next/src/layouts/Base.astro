---
import {getSiteSettings} from '../lib/cms';
const siteSettings=await getSiteSettings();
const telegramUrl='https://t.me/'+siteSettings.telegram;
interface Props { title: string; description: string; canonicalPath?: string; }
const { title, description, canonicalPath = '/' } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();
const orgId = homeUrl + '#organization';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': orgId, name: 'VECTA', url: homeUrl,
      description: 'Свадебная фото- и видеосъёмка в Москве и Подмосковье.',
      areaServed: { '@type': 'Place', name: 'Москва, Россия' } },
    { '@type': 'WebSite', name: 'VECTA', url: homeUrl, inLanguage: 'ru-RU',
      publisher: { '@id': orgId } }
  ]
};
const analyticsId = Number(import.meta.env.PUBLIC_YANDEX_METRIKA_ID || 0);
const analyticsEnabled = Number.isSafeInteger(analyticsId) && analyticsId > 0;
const isPreview = process.env.VERCEL_ENV === 'preview';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0a0b0b" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={isPreview ? 'noindex,nofollow' : 'index,follow'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/site.css" />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {analyticsEnabled && (
    <script is:inline define:vars={{ analyticsId }}>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        k=e.createElement(t);a=e.getElementsByTagName(t)[0];
        k.async=1;k.src=r;a.parentNode.insertBefore(k,a);
      })(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
      window.ym(analyticsId,'init',{
        clickmap:true,trackLinks:true,accurateTrackBounce:true
      });
      document.addEventListener('click',function(event){
        const target=event.target;
        const link=target instanceof Element
          ? target.closest('a[data-yandex-goal]') : null;
        if(link && typeof window.ym === 'function'){
          window.ym(analyticsId,'reachGoal',link.dataset.yandexGoal);
        }
      },{passive:true});
    </script>
  )}
</head>
<body>
  <a class="skip" href="#content">К содержанию</a>
  <header class="header">
    <a class="wordmark" href="/" aria-label="VECTA, на главную">VECTA<span class="wordmark-dot">.</span></a>
    <nav aria-label="Основная навигация">
      <a href="/#approach">Подход</a>
      <a href="/#services">Услуги</a>
      <a href="/#work">Истории</a>
      <a class="header-cta" href="/#contact">Уточнить дату <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="content"><slot /></main>
  <footer class="footer">
    <div>
      <a href="/" class="wordmark">VECTA<span class="wordmark-dot">.</span></a>
      <p>{siteSettings.footerDescription}</p>
    </div>
    <div>
      <a href={telegramUrl} data-yandex-goal="telegram_click"
         target="_blank" rel="noopener noreferrer">Telegram ↗</a>
      <a href="/#services">Услуги</a>
      <a href="/#contact">Уточнить дату</a>
    </div>
    <small>© {new Date().getFullYear()} {siteSettings.copyrightName}. Информация об услугах не является публичной офертой.</small>
  </footer>
</body>
</html>
