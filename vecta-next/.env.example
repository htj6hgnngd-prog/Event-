# PUBLIC_SITE_URL must be the confirmed canonical public wedding domain before release.
PUBLIC_SITE_URL=https://event-production-site.vercel.app

# To enable real Sanity Studio /admin and CMS content fetching:
# This is a non-secret project identifier (not a password or API token).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional Yandex Metrika (set a real ID after legal and consent review).
PUBLIC_YANDEX_METRIKA_ID=
